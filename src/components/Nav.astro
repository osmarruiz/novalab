---
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import {
  getLangFromUrl,
  useTranslations,
  getTranslatedPath,
  languages,
  defaultLang,
  type Lang,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Helper to get localized path
const getPath = (path: string) => (lang === defaultLang ? path : `/${lang}${path}`);

/** Main menu items with translations */
const textLinks: { label: string; href: string }[] = [
  { label: t("nav.home"), href: getPath("/") },
  { label: t("nav.projects"), href: getPath("/work/") },
];

// Get alternate language path for language switcher
const alternateLang: Lang = lang === "es" ? "en" : "es";
const alternateUrl = getTranslatedPath(Astro.url, alternateLang);
const cvPath = lang === "es" ? "/cv/Osmar_Ruiz_CV_ES.pdf" : "/cv/Osmar_Ruiz_CV_EN.pdf";
---

<nav>
  <div class="menu-header">
    <a href={getPath("/")} class="site-title"> Osmar Ruiz </a>
    <menu-button>
      <template>
        <button class="menu-button" aria-expanded="false">
          <span class="sr-only">Menu</span>
          <Icon icon="list" />
        </button>
      </template>
    </menu-button>
  </div>
  <noscript>
    <ul class="nav-items">
      {
        textLinks.map(({ label, href }) => (
          <li>
            <a
              aria-current={Astro.url.pathname === href}
              class:list={[
                "link",
                {
                  active:
                    Astro.url.pathname === href ||
                    (href !== "/" &&
                      href !== "/es/" &&
                      Astro.url.pathname.startsWith(href)),
                },
              ]}
              href={href}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </noscript>

  <div id="menu-content" hidden>
    <ul class="nav-items">
      {
        textLinks.map(({ label, href }) => (
          <li>
            <a
              aria-current={Astro.url.pathname === href}
              class:list={[
                "link",
                {
                  active:
                    Astro.url.pathname === href ||
                    (href !== "/" &&
                      href !== "/es/" &&
                      Astro.url.pathname.startsWith(href)),
                },
              ]}
              href={href}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-footer">
      <div class="controls">
        <a
          href={cvPath}
          target="_blank"
          download="Osmar_Ruiz_CV.pdf"
          class="icon-link"
          aria-label={t("nav.cv")}
          title={t("nav.cv")}
        >
          <Icon icon="file-text" size="1.15em" />
        </a>


        <a
          href="mailto:contact@osmarruiz.com"
          class="icon-link"
          aria-label="Email: contact@osmarruiz.com"
          title="contact@osmarruiz.com"
        >
          <Icon icon="envelope" size="1.15em" />
        </a>

        <a
          href="https://wa.me/50582228647"
          target="_blank"
          rel="noopener noreferrer"
          class="icon-link"
          aria-label="WhatsApp: +50582228647"
          title="WhatsApp: +50582228647"
        >
          <Icon icon="whatsapp-logo" size="1.15em" />
        </a>

        <!-- Language Switcher -->
        <a
          href={alternateUrl}
          class="lang-switch"
          aria-label={`Switch to ${languages[alternateLang]}`}
        >
          <span class="lang-flag">{alternateLang === "en" ? "🇺🇸" : "🇪🇸"}</span>
          <span class="lang-code">{alternateLang.toUpperCase()}</span>
        </a>

        <div class="theme-toggle">
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  class MenuButton extends HTMLElement {
    constructor() {
      super();
      this.appendChild(this.querySelector("template")!.content.cloneNode(true));
      const btn = this.querySelector("button")!;
      const menu = document.getElementById("menu-content")!;
      menu.hidden = true;
      menu.classList.add("menu-content");

      const setExpanded = (expand: boolean) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        menu.hidden = !expand;
      };
      btn.addEventListener("click", () => setExpanded(Boolean(menu.hidden)));

      // Auto-close when clicking outside on mobile
      document.addEventListener("click", (e) => {
        if (!menu.hidden && window.innerWidth < 800) {
          if (
            !menu.contains(e.target as Node) &&
            !btn.contains(e.target as Node)
          ) {
            setExpanded(false);
          }
        }
      });

      const handleViewports = (e: MediaQueryListEvent | MediaQueryList) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
      };
      const mediaQueries = window.matchMedia("(min-width: 50em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);

  // Sticky nav with blur effect
  const nav = document.querySelector("nav");
  if (nav) {
    let lastScroll = 0;

    const handleScroll = () => {
      const currentScroll = window.scrollY;

      if (currentScroll > 50) {
        nav.classList.add("scrolled");
      } else {
        nav.classList.remove("scrolled");
      }

      lastScroll = currentScroll;
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }
</script>

<style>
  nav {
    z-index: 9999;
    position: sticky;
    top: 0;
    margin-bottom: 3.5rem;
    font-family: var(--font-body);
    font-weight: 500;
    transition: background-color 0.4s ease, backdrop-filter 0.4s ease, box-shadow 0.4s ease;
  }

  /* Scrolled sticky glassmorphism container */
  nav.scrolled {
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--shadow-ambient);
  }

  .site-title {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    line-height: 1.1;
    color: var(--text-main);
    text-decoration: none;
    font-size: var(--text-lg);
    font-family: var(--font-brand);
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .site-title:hover {
    color: var(--primary);
  }

  .menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
  }

  .menu-button {
    display: flex;
    padding: 0.5rem;
    border: 0;
    border-radius: 9999px;
    background: var(--surface-container-high);
    color: var(--on-surface);
    cursor: pointer;
    box-shadow: var(--shadow-ambient);
  }

  .menu-button[hidden] {
    display: none;
  }

  .menu-content {
    background: var(--surface);
    position: absolute;
    left: 0; right: 0;
  }

  .link {
    display: inline-block;
    color: var(--on-surface-variant);
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
  }

  .nav-items li {
    width: 100%;
  }

  .nav-items .link {
    display: flex;
    width: 100%;
    align-items: center;
    min-height: 44px;
    border-radius: 0.75rem;
    padding: 0.65rem 1rem;
  }

  .link:hover {
    color: var(--on-surface);
    background-color: var(--surface-container-high);
  }

  .link.active {
    color: var(--on-primary);
    background: var(--primary);
    font-weight: 600;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }

  .social {
    display: flex;
    padding: 0.5rem;
    color: var(--on-surface-variant);
    transition: all 0.3s ease;
  }

  .social:hover {
    color: var(--primary);
    background-color: var(--surface-container-high);
    border-radius: 9999px;
  }
  
  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    color: var(--on-surface-variant);
    background: var(--surface-container-low);
    border: 1px solid var(--glass-border);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .icon-link:hover {
    color: var(--on-surface);
    background: var(--surface-container-high);
    border-color: var(--outline-variant);
    transform: translateY(-2px);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 9999px;
    font-size: var(--text-sm);
    color: var(--on-surface-variant);
    background: var(--surface-container-low);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .lang-switch:hover {
    color: var(--on-surface);
    background: var(--surface-container-high);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
  }

  .nav-items {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 2rem;
    background: var(--surface);
  }
  
  .menu-footer {
    display: flex;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    background: var(--surface);
  }

  .socials {
    display: flex;
    gap: 0.5rem;
  }

  @media (min-width: 50em) {
    nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 1.5rem 3rem;
      gap: 1rem;
    }
    
    .menu-header { padding: 0; }
    
    .menu-content { display: contents; }
    
    .nav-items {
      flex-direction: row;
      border-radius: 9999px;
      padding: 0.5rem;
      box-shadow: var(--shadow-ambient);
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .nav-items li {
      width: auto;
    }

    .nav-items .link {
      display: inline-block;
      width: auto;
      min-height: unset;
      border-radius: 9999px;
      padding: 0.5rem 1rem;
    }
    
    .menu-footer {
      justify-self: flex-end;
      padding: 0;
      background: transparent;
      gap: 2.5rem;
    }

    .socials {
      display: none;
    }
  }

  @media (min-width: 60em) {
    nav {
      padding: 2rem 5rem;
    }
    .socials {
      display: flex;
      justify-content: flex-end;
    }
  }

  @media (forced-colors: active) {
    .link.active {
      color: SelectedItem;
    }
  }
</style>
