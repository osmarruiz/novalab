---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isEs = lang === "es";

const currentYear = new Date().getFullYear();
const cvPath = isEs ? "/cv/Osmar_Ruiz_CV_ES.pdf" : "/cv/Osmar_Ruiz_CV_EN.pdf";
---

<footer class="w-full py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">
      <div class="flex flex-col lg:items-start items-center space-y-4">
        <div class="flex space-x-4">
          <a
            href="https://wa.me/50582228647"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center group p-2.5 rounded-xl bg-[#1414149c] border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-white hover:border-[var(--sec)]/40 transition"
            aria-label="WhatsApp"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path d="M12.004 2C6.48 2 2 6.48 2 12.004C2 13.77 2.463 15.467 3.342 16.992L2.054 21.701L6.903 20.432C8.389 21.247 10.147 21.708 12.004 21.708C17.528 21.708 22.008 17.228 22.008 11.704C22.008 6.18 17.528 2 12.004 2ZM16.914 15.42C16.711 15.992 15.908 16.46 15.26 16.6C14.817 16.696 14.238 16.772 12.296 15.968C9.813 14.94 8.214 12.419 8.09 12.256C7.969 12.093 7.085 10.92 7.085 9.708C7.085 8.496 7.702 7.907 7.945 7.659C8.148 7.452 8.472 7.371 8.796 7.371C8.902 7.371 8.999 7.376 9.088 7.38C9.348 7.393 9.478 7.408 9.648 7.818C9.859 8.329 10.37 9.58 10.435 9.71C10.5 9.84 10.557 10.011 10.468 10.182C10.379 10.352 10.314 10.442 10.184 10.596C10.054 10.751 9.917 10.938 9.803 11.052C9.673 11.182 9.535 11.32 9.689 11.588C9.843 11.856 10.379 12.731 11.166 13.433C12.18 14.337 13.008 14.629 13.308 14.755C13.535 14.852 13.803 14.828 13.965 14.657C14.176 14.43 14.436 14.057 14.704 13.684C14.899 13.408 15.142 13.375 15.394 13.473C15.653 13.562 17.032 14.244 17.316 14.382C17.6 14.52 17.787 14.585 17.852 14.707C17.917 14.828 17.917 15.42 17.714 15.992H16.914Z"/>
            </svg>
          </a>

          <a
            href="mailto:contact@osmarruiz.com"
            class="flex flex-col items-center group p-2.5 rounded-xl bg-[#1414149c] border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-white hover:border-[var(--sec)]/40 transition"
            aria-label="Email"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="flex flex-col items-center justify-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-[var(--sec)] font-semibold">
          {isEs ? "Arquitectura & Stack" : "Stack & Architecture"}
        </span>
        <p class="text-sm text-[var(--white-icon)] text-center max-w-xs leading-relaxed">
          {isEs 
            ? "Diseñado con Astro, Tailwind CSS y TypeScript para rendimiento máximo."
            : "Engineered with Astro, Tailwind CSS & TypeScript for optimal speed and reliability."}
        </p>
      </div>

      <div class="flex flex-col items-center lg:items-end justify-center space-y-2 text-center lg:text-right">
        <a 
          href={cvPath} 
          target="_blank" 
          download="Osmar_Ruiz_CV.pdf"
          class="text-sm text-[var(--sec)] hover:underline font-medium"
        >
          {isEs ? "Descargar Currículum Vitae (PDF) →" : "Download Full Résumé (PDF) →"}
        </a>
        <p class="text-xs text-[var(--white-icon)]">
          {isEs ? "Abierto a roles de ingeniería & DevOps" : "Open to Software & DevOps roles"}
        </p>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-[#ffffff10] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--white-icon)]">
        © {currentYear} Osmar Ruiz. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-xs text-[var(--white-icon)]">
        <a href="#home" class="hover:text-white transition">
          {isEs ? "Volver arriba ↑" : "Back to top ↑"}
        </a>
      </div>
    </div>
  </div>
</footer>
