---
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const cvPath = lang === "es" ? "/cv/Osmar_Ruiz_CV_ES.pdf" : "/cv/Osmar_Ruiz_CV_EN.pdf";
---

<footer>
	<div class="group">
		<p>
			{t("footer.designedWith")}
			<a
				href="https://astro.build/"
				target="_blank"
				rel="noopener noreferrer">Astro</a
			>
			<Icon icon="rocket-launch" size="1.2em" />
		</p>
		<p>&copy; {currentYear} Osmar Ruiz</p>
	</div>
	<p class="socials">
		<a href={cvPath} target="_blank" download="Osmar_Ruiz_CV.pdf" class="social-link" aria-label={t("nav.cv")} title={t("nav.cv")}>
			<Icon icon="file-text" size="1.25em" />
		</a>
		<a href="mailto:contact@osmarruiz.com" class="social-link" aria-label="Email: contact@osmarruiz.com" title="contact@osmarruiz.com">
			<Icon icon="envelope" size="1.25em" />
		</a>
		<a href="https://wa.me/50582228647" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="WhatsApp: +50582228647" title="WhatsApp: +50582228647">
			<Icon icon="whatsapp-logo" size="1.25em" />
		</a>
	</p>
</footer>
<style>
	footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		margin-top: auto;
		padding: 3rem 2rem 6rem;
		text-align: center;
		color: var(--on-surface-variant);
		font-size: var(--text-sm);
	}

	footer a {
		color: var(--on-surface-variant);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition:
			text-decoration-color var(--theme-transition),
			color 0.2s ease;
	}

	footer a:hover,
	footer a:focus {
		text-decoration-color: currentColor;
		color: var(--primary);
	}

	.group {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}

	.socials {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		z-index: 1;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 9999px;
		background: var(--surface-container-low);
		border: 1px solid var(--glass-border);
		color: var(--on-surface-variant);
		transition: all 0.25s ease;
	}

	.social-link:hover {
		color: var(--on-surface);
		background: var(--surface-container-high);
		border-color: var(--outline-variant);
		transform: translateY(-2px);
	}

	@media (min-width: 50em) {
		footer {
			padding: 4rem 5rem 4rem;
			gap: 1.5rem;
		}

		.group {
			flex-direction: row;
			gap: 1.5rem;
			flex-wrap: wrap;
		}

		.socials {
			margin-top: 0.5rem;
		}
	}
</style>
