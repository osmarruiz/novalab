---
import { getAllProjects, getFeaturedProjects, projectTranslations } from "../data/projects";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isEs = lang === "es";

const allProjects = getAllProjects();
const featuredProjects = getFeaturedProjects();

// Helper to format markdown links/bold in overview
function formatMarkdown(text: string) {
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>')
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-[var(--sec)] hover:underline font-medium">$1</a>');
}
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <div class="space-y-1 mb-8">
      <h2 class="text-sm font-semibold tracking-wider uppercase text-[var(--sec)] shiny-sec">
        {isEs ? "SaaS & Arquitectura Backend" : "Production SaaS & Backend Architecture"}
      </h2>
      <h3 class="text-3xl md:text-4xl font-semibold">
        {isEs ? "Casos de Estudio Destacados" : "Featured Case Studies"}
      </h3>
      <p class="text-sm md:text-base text-[var(--white-icon)] max-w-2xl">
        {isEs 
          ? "Plataforma SaaS operando activamente en la nube y arquitectura de backend de misión crítica con alta consistencia transaccional."
          : "Production SaaS platform deployed live in the cloud and mission-critical backend architecture engineered for transactional consistency."}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        featuredProjects.map((project) => {
          const trans = projectTranslations[project.slug]?.[lang];
          const projectTitle = trans?.title || project.slug;
          const projectDesc = trans?.description || "";

          return (
            <div class="group bg-[#14141460] border border-[var(--white-icon-tr)] hover:border-[var(--sec)]/40 rounded-2xl overflow-hidden transition-all duration-300">
              <button
                type="button"
                data-open-modal={project.slug}
                class="block w-full text-left cursor-pointer focus:outline-none"
              >
                <div class="overflow-hidden mb-4 relative bg-[#181818] aspect-video">
                  <img
                    src={project.img}
                    alt={project.img_alt || projectTitle}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute top-3 right-3 flex flex-wrap gap-1.5">
                    {project.isSaaS && (
                      <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-semibold flex items-center gap-1.5 backdrop-blur-md">
                        <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        Live SaaS
                      </span>
                    )}
                    {project.tags.slice(0, 2).map((tag) => (
                      <span class="text-xs px-2.5 py-0.5 rounded-full bg-black/70 backdrop-blur-md border border-white/10 text-[var(--white)] font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="px-5 pb-5 space-y-3">
                  <div class="flex items-start justify-between gap-3">
                    <h4 class="text-xl md:text-2xl font-semibold group-hover:text-[var(--sec)] transition-colors">
                      {projectTitle}
                    </h4>
                    <span class="text-xs px-2.5 py-1 rounded-full bg-[var(--sec)]/10 text-[var(--sec)] border border-[var(--sec)]/20 whitespace-nowrap font-medium">
                      {isEs ? "Ver detalles" : "View details"}
                    </span>
                  </div>

                  <p class="text-sm text-[var(--white-icon)] line-clamp-2 leading-relaxed">
                    {projectDesc}
                  </p>

                  <div class="flex items-center justify-between pt-2 border-t border-white/5 text-xs text-[var(--white-icon)]">
                    <div class="flex flex-wrap gap-1.5">
                      {project.tags.map((tag) => (
                        <span class="text-[0.7rem] px-2 py-0.5 rounded bg-white/5 text-[var(--white-icon)]">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <span class="flex items-center gap-1 font-medium text-[var(--sec)] group-hover:translate-x-1 transition-transform">
                      {isEs ? "Explorar" : "Explore"}
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </button>
            </div>
          );
        })
      }
    </div>

    <!-- Secondary GitHub Archive Link -->
    <div class="mt-8 text-center">
      <a
        href="https://github.com/OsmarRuiz"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs md:text-sm text-[var(--white-icon)] hover:text-white transition px-4 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-[var(--sec)]/30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>{isEs ? "Explorar repositorios de código abierto y utilidades en GitHub →" : "Explore open-source repositories & utilities on GitHub →"}</span>
      </a>
    </div>

    <!-- Modern Dark Dialog Modals with Carousel -->
    {
      allProjects.map((project) => {
        const trans = projectTranslations[project.slug]?.[lang];
        if (!trans) return null;
        const c = trans.content;
        const mediaList = project.gallery && project.gallery.length > 0 ? project.gallery : [project.img];

        return (
          <dialog
            id={`modal-${project.slug}`}
            class="project-dialog bg-[#121212]/95 backdrop-blur-2xl border border-white/10 text-[var(--white)] rounded-3xl p-0 w-[94vw] max-w-4xl max-h-[90vh] overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.8)] backdrop:bg-black/80 backdrop:backdrop-blur-sm"
          >
            <div class="p-6 md:p-8 overflow-y-auto max-h-[90vh] space-y-6">
              <!-- Modal Header -->
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-white/10 pb-4">
                <div class="space-y-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    {project.isSaaS && (
                      <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-semibold flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        Active Production SaaS
                      </span>
                    )}
                    {project.tags.map((tag) => (
                      <span class="text-xs px-2.5 py-0.5 rounded-full bg-[var(--sec)]/10 text-[var(--sec)] border border-[var(--sec)]/20 font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h3 class="text-xl md:text-3xl font-bold">{trans.title}</h3>
                </div>
                <div class="flex items-center gap-2 shrink-0 self-end sm:self-start">
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 md:px-3.5 md:py-2 rounded-xl bg-[var(--sec)] text-black text-xs font-semibold hover:opacity-90 transition shadow-md shadow-[var(--sec)]/20 cursor-pointer whitespace-nowrap shrink-0"
                    >
                      <span>{isEs ? "Visitar App" : "Live App"}</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  )}
                  <button
                    type="button"
                    data-close-modal={`modal-${project.slug}`}
                    class="p-2 md:p-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-[var(--white-icon)] hover:text-white border border-white/10 transition cursor-pointer"
                    aria-label="Cerrar"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Media: Video or Single Carousel -->
              {project.videoUrl ? (
                <div class="aspect-video rounded-2xl overflow-hidden border border-white/10 bg-black">
                  <iframe
                    src={project.videoUrl}
                    title={trans.title}
                    class="w-full h-full"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
              ) : (
                <div class="relative rounded-2xl overflow-hidden border border-white/10 bg-[#161616]" data-carousel={project.slug}>
                  <div class="carousel-track flex transition-transform duration-300 ease-out aspect-video">
                    {mediaList.map((imgSrc, i) => (
                      <div class="min-w-full h-full flex-shrink-0 relative bg-[#181818]">
                        <img
                          src={imgSrc}
                          alt={`${trans.title} screenshot ${i + 1}`}
                          class="w-full h-full object-contain bg-black/40"
                          loading="lazy"
                        />
                      </div>
                    ))}
                  </div>

                  {mediaList.length > 1 && (
                    <>
                      <button
                        type="button"
                        class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/70 hover:bg-black text-white border border-white/20 transition cursor-pointer"
                        aria-label="Previous image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                      </button>
                      <button
                        type="button"
                        class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/70 hover:bg-black text-white border border-white/20 transition cursor-pointer"
                        aria-label="Next image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </button>
                      <div class="carousel-dots absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/10">
                        {mediaList.map((_, i) => (
                          <button
                            type="button"
                            data-dot-index={i}
                            class={`size-2 rounded-full transition-all cursor-pointer ${i === 0 ? "bg-[var(--sec)] w-4" : "bg-white/40 hover:bg-white"}`}
                            aria-label={`Go to slide ${i + 1}`}
                          />
                        ))}
                      </div>
                    </>
                  )}
                </div>
              )}

              <!-- Overview with Markdown parsing -->
              <div class="space-y-4 text-sm md:text-base text-[var(--white-icon)] leading-relaxed">
                <p set:html={formatMarkdown(c.overview)} />
                {c.quote && (
                  <blockquote class="p-4 rounded-xl bg-white/5 border-l-4 border-[var(--sec)] italic text-[var(--white)]">
                    "{c.quote}"
                  </blockquote>
                )}
              </div>

              <!-- Features Grid -->
              {c.features && c.features.length > 0 && (
                <div class="space-y-3 pt-2">
                  <h4 class="text-lg font-semibold text-[var(--white)]">
                    {isEs ? "Características Clave" : "Key Features"}
                  </h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {c.features.map((feat) => (
                      <div class="p-4 rounded-xl bg-[#181818] border border-white/5 space-y-2">
                        <h5 class="text-sm font-semibold text-[var(--sec)]">{feat.title}</h5>
                        <ul class="text-xs space-y-1.5 text-[var(--white-icon)]">
                          {feat.items.map((item) => (
                            <li class="flex items-start gap-1.5">
                              <span class="text-[var(--sec)]">•</span>
                              <span><strong class="text-white">{item.title}:</strong> {item.description}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Tech Stack Table / Badges -->
              {c.techStack && c.techStack.length > 0 && (
                <div class="space-y-2 pt-2 border-t border-white/10">
                  <h4 class="text-sm font-semibold uppercase tracking-wider text-[var(--sec)]">
                    {isEs ? "Tecnologías & Arquitectura" : "Technologies & Architecture"}
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    {c.techStack.map((tech) => (
                      <span class="text-xs px-3 py-1 rounded-lg bg-white/5 border border-white/10 text-[var(--white)]">
                        <span class="text-[var(--white-icon)] mr-1">{tech.category}:</span>
                        <strong class="text-white">{tech.technology}</strong>
                      </span>
                    ))}
                  </div>
                </div>
              )}

              <!-- Modal Footer -->
              <div class="pt-4 border-t border-white/10 flex items-center justify-end">
                <button
                  type="button"
                  data-close-modal={`modal-${project.slug}`}
                  class="px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold transition cursor-pointer text-xs md:text-sm"
                >
                  {isEs ? "Cerrar" : "Close"}
                </button>
              </div>
            </div>
          </dialog>
        );
      })
    }
  </div>
</section>

<script>
  function setupModals() {
    document.querySelectorAll("[data-open-modal]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.getAttribute("data-open-modal");
        const modal = document.getElementById(`modal-${slug}`) as HTMLDialogElement;
        if (modal) {
          modal.showModal();
          document.body.style.overflow = "hidden";
        }
      });
    });

    document.querySelectorAll("[data-close-modal]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const modalId = btn.getAttribute("data-close-modal");
        const modal = document.getElementById(modalId || "") as HTMLDialogElement;
        if (modal) {
          modal.close();
          document.body.style.overflow = "auto";
        }
      });
    });

    // Close on backdrop click
    document.querySelectorAll(".project-dialog").forEach((dialog) => {
      dialog.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.tagName === "DIALOG") {
          (dialog as HTMLDialogElement).close();
          document.body.style.overflow = "auto";
        }
      });
    });

    // Carousel navigation logic
    document.querySelectorAll("[data-carousel]").forEach((carousel) => {
      const track = carousel.querySelector(".carousel-track") as HTMLElement;
      const slides = carousel.querySelectorAll(".carousel-track > div");
      const prevBtn = carousel.querySelector(".carousel-prev") as HTMLButtonElement;
      const nextBtn = carousel.querySelector(".carousel-next") as HTMLButtonElement;
      const dots = carousel.querySelectorAll("[data-dot-index]") as NodeListOf<HTMLButtonElement>;

      if (!track || slides.length <= 1) return;

      let currentIndex = 0;

      const updateSlide = (idx: number) => {
        currentIndex = (idx + slides.length) % slides.length;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        dots.forEach((dot, dIdx) => {
          const isActive = dIdx === currentIndex;
          dot.className = `size-2 rounded-full transition-all cursor-pointer ${isActive ? "bg-[var(--sec)] w-4" : "bg-white/40 hover:bg-white"}`;
        });
      };

      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        updateSlide(currentIndex - 1);
      });

      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        updateSlide(currentIndex + 1);
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          const dotIdx = Number(dot.getAttribute("data-dot-index") || 0);
          updateSlide(dotIdx);
        });
      });
    });
  }

  setupModals();
  document.addEventListener("astro:page-load", setupModals);
</script>

<style>
  dialog:not([open]) {
    display: none;
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
  }

  dialog[open] {
    animation: zoomIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>
