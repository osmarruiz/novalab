---
import Icon from "../Icon.astro";

interface Props {
    images: string[];
    title: string;
    label: string;
}

const { images, title, label } = Astro.props;
const uniqueId = `gallery-${Math.random().toString(36).substring(2, 9)}`;
---

{images && images.length > 0 && (
    <section class="gallery-section" id={uniqueId}>
        <div class="gallery-header">
            <h2 class="section-title">{label}</h2>
            <span class="slide-count">
                <span class="curr-idx">1</span> / <span>{images.length}</span>
            </span>
        </div>

        <div class="carousel-container">
            <!-- Main Display Stage -->
            <div class="stage-wrapper">
                <div class="stage-track">
                    {images.map((img, idx) => (
                        <div class:list={["stage-slide", { active: idx === 0 }]} data-index={idx}>
                            <img
                                src={img}
                                alt={`${title} - ${idx + 1}`}
                                loading={idx === 0 ? "eager" : "lazy"}
                            />
                        </div>
                    ))}
                </div>

                {images.length > 1 && (
                    <>
                        <button type="button" class="nav-btn prev-btn" aria-label="Imagen anterior">
                            <Icon icon="arrow-left" size="1.25rem" />
                        </button>
                        <button type="button" class="nav-btn next-btn" aria-label="Siguiente imagen">
                            <Icon icon="arrow-right" size="1.25rem" />
                        </button>
                    </>
                )}
            </div>

            <!-- Thumbnail Strip -->
            {images.length > 1 && (
                <div class="thumbnail-strip" role="tablist" aria-label="Miniaturas de la galería">
                    {images.map((img, idx) => (
                        <button
                            type="button"
                            class:list={["thumb-item", { active: idx === 0 }]}
                            data-index={idx}
                            aria-label={`Ver imagen ${idx + 1}`}
                        >
                            <img src={img} alt={`Miniatura ${idx + 1}`} loading="lazy" />
                        </button>
                    ))}
                </div>
            )}
        </div>
    </section>
)}

<script>
    function setupGalleries() {
        document.querySelectorAll('.gallery-section').forEach((gallery) => {
            const slides = gallery.querySelectorAll<HTMLElement>('.stage-slide');
            const thumbs = gallery.querySelectorAll<HTMLElement>('.thumb-item');
            const prevBtn = gallery.querySelector<HTMLButtonElement>('.prev-btn');
            const nextBtn = gallery.querySelector<HTMLButtonElement>('.next-btn');
            const countEl = gallery.querySelector<HTMLElement>('.curr-idx');
            const total = slides.length;

            if (total <= 1) return;

            let currentIndex = 0;

            function goToSlide(index: number) {
                if (index < 0) index = total - 1;
                if (index >= total) index = 0;
                currentIndex = index;

                slides.forEach((slide, i) => {
                    if (i === currentIndex) {
                        slide.classList.add('active');
                    } else {
                        slide.classList.remove('active');
                    }
                });

                thumbs.forEach((thumb, i) => {
                    if (i === currentIndex) {
                        thumb.classList.add('active');
                        thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                    } else {
                        thumb.classList.remove('active');
                    }
                });

                if (countEl) {
                    countEl.textContent = String(currentIndex + 1);
                }
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    goToSlide(currentIndex - 1);
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    goToSlide(currentIndex + 1);
                });
            }

            thumbs.forEach((thumb) => {
                thumb.addEventListener('click', (e) => {
                    e.preventDefault();
                    const idx = Number(thumb.getAttribute('data-index'));
                    if (!isNaN(idx)) {
                        goToSlide(idx);
                    }
                });
            });

            // Touch Swipe
            let startX = 0;
            const stage = gallery.querySelector('.stage-wrapper');
            if (stage) {
                stage.addEventListener('touchstart', (e) => {
                    const touch = (e as TouchEvent).touches[0];
                    if (touch) startX = touch.clientX;
                }, { passive: true });

                stage.addEventListener('touchend', (e) => {
                    const touch = (e as TouchEvent).changedTouches[0];
                    if (!touch) return;
                    const diff = touch.clientX - startX;
                    if (diff > 40) {
                        goToSlide(currentIndex - 1);
                    } else if (diff < -40) {
                        goToSlide(currentIndex + 1);
                    }
                }, { passive: true });
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupGalleries);
    } else {
        setupGalleries();
    }
</script>

<style>
    .gallery-section {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        width: 100%;
    }

    @media (min-width: 50em) {
        .gallery-section {
            gap: 1.75rem;
        }
    }

    .gallery-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .section-title {
        font-size: var(--text-2xl);
        font-weight: 700;
        color: var(--on-surface);
        margin: 0;
        letter-spacing: -0.02em;
    }

    .slide-count {
        font-size: var(--text-sm);
        color: var(--on-surface-variant);
        font-weight: 600;
    }

    .carousel-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }

    /* Main Display Stage */
    .stage-wrapper {
        position: relative;
        width: 100%;
        border-radius: 0.75rem;
        overflow: hidden;
        background-color: #0b0f19;
        border: 1px solid var(--outline-variant);
        box-shadow: var(--shadow-ambient);
        aspect-ratio: 16/9;
    }

    @media (min-width: 50em) {
        .stage-wrapper {
            border-radius: 1.25rem;
        }
    }

    .stage-track {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .stage-slide {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #0b0f19;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.35s ease, visibility 0.35s ease;
        pointer-events: none;
    }

    .stage-slide.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .stage-slide img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    /* Navigation Arrows */
    .nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: rgba(15, 23, 42, 0.85);
        color: var(--on-surface);
        border: 1px solid var(--outline-variant);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(8px);
        transition: all 0.25s ease;
        opacity: 0.9;
    }

    .nav-btn:hover {
        opacity: 1;
        transform: translateY(-50%) scale(1.08);
        background-color: var(--primary);
        color: var(--on-primary);
        border-color: var(--primary);
    }

    .prev-btn {
        left: 1rem;
    }

    .next-btn {
        right: 1rem;
    }

    /* Thumbnail Strip */
    .thumbnail-strip {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
        scrollbar-width: thin;
    }

    .thumb-item {
        flex: 0 0 100px;
        aspect-ratio: 16/9;
        padding: 0;
        background-color: #0b0f19;
        border: 2px solid transparent;
        border-radius: 0.5rem;
        overflow: hidden;
        cursor: pointer;
        opacity: 0.5;
        transition: all 0.2s ease;
    }

    @media (min-width: 40em) {
        .thumb-item {
            flex: 0 0 130px;
        }
    }

    @media (min-width: 60em) {
        .thumb-item {
            flex: 0 0 160px;
        }
    }

    .thumb-item:hover {
        opacity: 0.85;
        transform: translateY(-2px);
    }

    .thumb-item.active {
        opacity: 1;
        border-color: var(--primary);
        box-shadow: 0 0 12px rgba(var(--primary-rgb, 99, 102, 241), 0.4);
    }

    .thumb-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>
