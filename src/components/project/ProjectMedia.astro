---
import ProjectCarousel from "./ProjectCarousel.astro";

interface Props {
    videoUrl?: string;
    gallery?: string[];
    img?: string;
    demoLabel: string;
    galleryLabel: string;
    projectTitle: string;
}

const { videoUrl, gallery, img, demoLabel, galleryLabel, projectTitle } = Astro.props;
const images = gallery && gallery.length > 0 ? gallery : (img && !videoUrl ? [img] : []);
---

<div class="media-stack">
    {videoUrl && (
        <section class="video-section" data-aos="fade-up">
            <h2 class="section-title">{demoLabel}</h2>
            <div class="video-frame">
                <iframe
                    src={videoUrl}
                    title={`Demo - ${projectTitle}`}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                />
            </div>
        </section>
    )}

    {images && images.length > 0 && (
        <ProjectCarousel
            images={images}
            title={projectTitle}
            label={galleryLabel}
        />
    )}
</div>

<style>
    .media-stack {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    .video-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    @media (min-width: 50em) {
        .video-section {
            gap: 2rem;
        }
    }

    .section-title {
        font-size: var(--text-2xl);
        font-weight: 700;
        color: var(--on-surface);
        margin: 0;
        letter-spacing: -0.02em;
    }

    .video-frame {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        border-radius: 0.75rem;
        overflow: hidden;
        background-color: var(--surface-container-low);
    }

    @media (min-width: 50em) {
        .video-frame {
            border-radius: 1.25rem;
        }
    }

    .video-frame iframe {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
    }
</style>
