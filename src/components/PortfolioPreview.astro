---
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n/utils";
import { getProjectTranslation } from "../data/projects";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const lang = getLangFromUrl(Astro.url) as "es" | "en";
const t = useTranslations(lang);

const { project } = Astro.props;
const translation = getProjectTranslation(project.slug, lang);
const projectUrl = getLocalePath(`/work/${project.slug}`, lang);
---

<a class="card" href={projectUrl}>
  <div class="card-overlay"></div>
  <span class="title">{translation?.title || project.slug}</span>
  <img
    class="main-img"
    src={project.img}
    alt={project.img_alt || ""}
    loading="lazy"
    decoding="async"
  />
  {
    project.img_hover && (
      <img
        class="hover-img"
        src={project.img_hover}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="card-content">
    <div class="tags">
      {
        project.tags
          ?.slice(0, 3)
          .map((tag: string) => <span class="tag">{tag}</span>)
      }
    </div>
    <span class="view-project">
      {t("projects.viewProject")}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </span>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    height: 18rem;
    background: var(--surface-container-low);
    border: 0;
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    font-family: var(--font-body);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover {
    background: var(--surface-container-highest);
    transform: translateY(-2px);
    box-shadow: var(--shadow-ambient);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      135deg,
      transparent 0%,
      transparent 50%,
      rgba(92, 92, 92, 0.1) 100%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .card:hover .card-overlay {
    opacity: 1;
  }

  .title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 4;
    margin: 0.75rem;
    padding: 0.5rem 1rem;
    background: var(--glass-bg);
    color: var(--on-surface);
    border-radius: 0.75rem;
    position: relative;
    font-size: var(--text-base);
    font-family: var(--font-brand);
    font-weight: 600;
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
  }

  .card:hover .title {
    background: var(--primary);
    color: var(--on-primary);
    border-color: var(--btn-border);
    transform: translateY(-2px);
  }

  .card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      transparent 100%
    );
  }

  .tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease 0.1s;
  }

  .card:hover .tags {
    opacity: 1;
    transform: translateY(0);
  }

  .tag {
    padding: 0.2rem 0.6rem;
    background: var(--surface-container-high);
    border: 1px solid var(--glass-border);
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--on-surface);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .view-project {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1.1rem;
    background: var(--gradient-accent);
    color: var(--on-primary);
    border: 1px solid var(--btn-border);
    box-shadow: var(--btn-shadow);
    border-radius: 9999px;
    font-size: var(--text-sm);
    font-weight: 700;
    opacity: 0;
    transform: translateX(10px);
    transition: all 0.3s ease;
  }

  .card:hover .view-project {
    opacity: 1;
    transform: translateX(0);
  }

  .view-project:hover {
    transform: scale(1.05) !important;
  }

  .view-project svg {
    transition: transform 0.2s ease;
  }

  .card:hover .view-project svg {
    animation: arrowBounce 1s ease infinite;
  }

  @keyframes arrowBounce {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(4px);
    }
  }

  img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    filter: saturate(0.9) brightness(0.95);
  }

  .main-img {
    opacity: 1;
    z-index: 1;
  }

  .hover-img {
    opacity: 0;
    z-index: 2;
  }

  .card:hover img {
    filter: saturate(1.2) brightness(1.05) contrast(1.05);
  }

  .card:hover .hover-img {
    opacity: 1;
    transform: scale(1.08);
  }

  .card:hover .main-img {
    opacity: 0;
    transform: scale(1.08);
  }

  @media (min-width: 50em) {
    .card {
      height: 22rem;
      border-radius: 1.5rem;
    }

    .title {
      margin: 1rem;
      font-size: var(--text-lg);
      border-radius: 0.75rem;
    }

    .card-content {
      padding: 1.25rem;
    }

    .tag {
      font-size: 0.75rem;
      padding: 0.25rem 0.65rem;
    }
  }
</style>
