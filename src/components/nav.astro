---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isEs = lang === "es";

const alternateLang = isEs ? "en" : "es";
const alternateUrl = isEs ? "/" : "/es/";

const navItems = isEs
  ? [
      {
        label: "Inicio",
        href: "#home",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
      },
      {
        label: "Proyectos",
        href: "#projects",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
      },
      {
        label: "Contacto",
        href: "#contact",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
      },
    ]
  : [
      {
        label: "Home",
        href: "#home",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
      },
      {
        label: "Projects",
        href: "#projects",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
      },
      {
        label: "Contact",
        href: "#contact",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
      },
    ];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[#101010]/90 border border-white/15 backdrop-blur-xl transition-all duration-300 md:top-6 md:bottom-auto bottom-4 w-auto max-w-[96vw] px-2.5 sm:px-4 md:px-6 rounded-full shadow-2xl"
  >
    <div class="flex items-center gap-2 sm:gap-4 md:gap-6 py-1.5 md:py-2.5">
      <ul class="flex items-center gap-1 sm:gap-3 md:gap-6">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center gap-1 sm:gap-1.5 text-[var(--white-icon)] hover:text-white transition-colors text-xs md:text-sm font-medium py-1 px-1.5 sm:px-2 rounded-lg"
              >
                <span class="md:hidden flex items-center justify-center [&>svg]:w-4 [&>svg]:h-4">
                  <fragment set:html={item.icon} />
                </span>
                <span class="hidden md:inline-block">{item.label}</span>
                <span class="md:hidden text-[0.7rem]">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center pl-1.5 sm:pl-3 md:pl-4 border-l border-white/10 shrink-0">
        <a
          href={alternateUrl}
          class="flex items-center gap-1 sm:gap-1.5 text-[0.7rem] md:text-xs px-2 sm:px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/10 text-[var(--white)] font-semibold border border-white/15 transition-all hover:border-[var(--sec)] shadow-sm shrink-0 whitespace-nowrap"
          aria-label={`Switch to ${alternateLang.toUpperCase()}`}
          title={isEs ? "Switch to English" : "Cambiar a Español"}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" class="text-[var(--sec)] shrink-0">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" x2="22" y1="12" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span>{alternateLang.toUpperCase()}</span>
        </a>
      </div>
    </div>
  </nav>
</div>

<script>
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const targetId = target.getAttribute("href")?.substring(1) || "";
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: "smooth",
        });
      }
    });
  });
</script>
