---
// Scroll indicator arrow
---

<div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-arrow">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M12 5v14M5 12l7 7 7-7"></path>
        </svg>
    </div>
    <span class="scroll-text">Scroll</span>
</div>

<style>
    .scroll-indicator {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        color: var(--gray-400);
        opacity: 0.7;
        transition: opacity 0.3s ease;
    }

    .scroll-indicator:hover {
        opacity: 1;
    }

    .scroll-arrow {
        animation: bounce 2s infinite;
    }

    .scroll-arrow svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    .scroll-text {
        font-size: var(--text-sm);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 500;
    }

    @keyframes bounce {
        0%,
        20%,
        50%,
        80%,
        100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-8px);
        }
        60% {
            transform: translateY(-4px);
        }
    }

    @media (max-width: 50em) {
        .scroll-indicator {
            display: none;
        }
    }
</style>

<script>
    const scrollIndicator = document.querySelector(".scroll-indicator");

    if (scrollIndicator) {
        const hideOnScroll = () => {
            if (window.scrollY > 100) {
                (scrollIndicator as HTMLElement).style.opacity = "0";
                (scrollIndicator as HTMLElement).style.pointerEvents = "none";
            } else {
                (scrollIndicator as HTMLElement).style.opacity = "0.7";
                (scrollIndicator as HTMLElement).style.pointerEvents = "auto";
            }
        };

        window.addEventListener("scroll", hideOnScroll, { passive: true });
    }
</script>
