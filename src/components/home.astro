---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isEs = lang === "es";

const cvPath = isEs ? "/cv/Osmar_Ruiz_CV_ES.pdf" : "/cv/Osmar_Ruiz_CV_EN.pdf";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-32 pb-14">
    <div class="text-left space-y-4">

      <p class="text-md md:text-lg text-[var(--white-icon)]">
        {isEs ? "Hola, soy" : "Hi, I'm"} <strong class="text-[var(--white)] font-semibold">Osmar Ruiz</strong>
      </p>

      <div
        class="flex flex-col lg:flex-row lg:items-center space-y-4 lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-6xl font-bold tracking-tight text-pretty leading-none"
        >
          {isEs ? (
            <>
              Ingeniero DevOps & <br /> Backend
            </>
          ) : (
            <>
              DevOps & Backend <br /> Engineer
            </>
          )}
        </h1>
        <p class="text-md md:text-2xl text-[var(--white-icon)] font-light leading-relaxed">
          {isEs ? (
            <>
              Especializado en <span class="text-[var(--sec)] shiny-sec font-medium">infraestructura cloud resiliente</span>, automatización de pipelines CI/CD y backends escalables de alto rendimiento (.NET, Go, Python). Creador y operador de Nova Ticket SaaS.
            </>
          ) : (
            <>
              Specialized in <span class="text-[var(--sec)] shiny-sec font-medium">resilient cloud infrastructure</span>, automated CI/CD pipelines, and high-throughput backends (.NET, Go, Python). Creator and operator of Nova Ticket SaaS.
            </>
          )}
        </p>
      </div>


      <!-- CTA Row -->
      <div class="flex flex-wrap items-center justify-start gap-3 pt-3 md:pt-4">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 text-sm font-semibold text-black bg-[var(--sec)] hover:opacity-90 px-5 py-3 rounded-xl transition duration-300 hover:scale-105 shadow-lg shadow-[var(--sec)]/20 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          {isEs ? "Contactar para Roles DevOps / Backend" : "Discuss DevOps & Backend Roles"}
        </a>

        <a
          target="_blank"
          href={isEs ? "https://wa.me/50582228647?text=Hola%20Osmar,%20vi%20tu%20perfil%20DevOps%20y%20me%20gustar%C3%ADa%20conversar." : "https://wa.me/50582228647?text=Hi%20Osmar,%20I%20saw%20your%20DevOps%20profile%20and%20would%20like%20to%20connect."}
          aria-label="WhatsApp"
          title="WhatsApp: +50582228647"
          class="text-[#25D366] hover:text-white transition duration-300 ease-in-out border border-[#25D366]/30 p-3 rounded-xl bg-[#25D366]/10 hover:bg-[#25D366]/20 hover:scale-105 inline-flex items-center gap-2 text-sm font-medium"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-5"
          >
            <path
              d="M12.004 2C6.48 2 2 6.48 2 12.004C2 13.77 2.463 15.467 3.342 16.992L2.054 21.701L6.903 20.432C8.389 21.247 10.147 21.708 12.004 21.708C17.528 21.708 22.008 17.228 22.008 11.704C22.008 6.18 17.528 2 12.004 2ZM16.914 15.42C16.711 15.992 15.908 16.46 15.26 16.6C14.817 16.696 14.238 16.772 12.296 15.968C9.813 14.94 8.214 12.419 8.09 12.256C7.969 12.093 7.085 10.92 7.085 9.708C7.085 8.496 7.702 7.907 7.945 7.659C8.148 7.452 8.472 7.371 8.796 7.371C8.902 7.371 8.999 7.376 9.088 7.38C9.348 7.393 9.478 7.408 9.648 7.818C9.859 8.329 10.37 9.58 10.435 9.71C10.5 9.84 10.557 10.011 10.468 10.182C10.379 10.352 10.314 10.442 10.184 10.596C10.054 10.751 9.917 10.938 9.803 11.052C9.673 11.182 9.535 11.32 9.689 11.588C9.843 11.856 10.379 12.731 11.166 13.433C12.18 14.337 13.008 14.629 13.308 14.755C13.535 14.852 13.803 14.828 13.965 14.657C14.176 14.43 14.436 14.057 14.704 13.684C14.899 13.408 15.142 13.375 15.394 13.473C15.653 13.562 17.032 14.244 17.316 14.382C17.6 14.52 17.787 14.585 17.852 14.707C17.917 14.828 17.917 15.42 17.714 15.992H16.914Z"
            ></path>
          </svg>
          WhatsApp
        </a>

        <a
          href={cvPath}
          target="_blank"
          download="Osmar_Ruiz_CV.pdf"
          class="inline-flex items-center gap-2 text-sm font-medium text-[var(--white-icon)] border border-white/10 bg-white/5 hover:bg-white/10 px-4 py-3 rounded-xl transition duration-300 hover:text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="12" y2="18"/><line x1="15" y1="15" x2="12" y2="18"/>
          </svg>
          CV (PDF)
        </a>
      </div>
    </div>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList lang={lang} client:load />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
