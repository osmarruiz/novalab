---
import LabLayout from '../layouts/LabLayout.astro';
import LabPriceCatalog from '../React/LabPriceCatalog';
---

<LabLayout>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16">
    <!-- Clean Minimal Hero -->
    <div class="mb-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono mb-2">
        <span>Maquila & Microelectrónica para Talleres</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-zinc-100 tracking-tight mb-1">
        Tarifario Directo de Laboratorio
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-2xl">
        Precios netos para técnicos y talleres. Tiempos en mesa de 24 a 48h.
      </p>
    </div>

    <!-- Diagnostic policy banner outside the table -->
    <div class="mb-5 p-3 rounded-xl bg-purple-950/20 border border-purple-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono">
      <div class="flex items-center gap-2 text-zinc-300">
        <span class="text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">Diagnóstico GRATIS</span>
        <span>al aprobar la reparación.</span>
      </div>
      <div class="text-[11px] text-zinc-400">
        <span>Solo C$250 / $8 si el taller rechaza el presupuesto.</span>
      </div>
    </div>

    <!-- Interactive Direct Catalog Table -->
    <LabPriceCatalog client:load />

    <!-- Simple Shipping & Delivery Note -->
    <div class="mt-6 p-4 rounded-xl bg-zinc-900/50 border border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400 font-mono">
      <div>
        <span>📦 Recepción local y encomiendas departamentales. Diagnóstico con video/fotos bajo microscopio incluido.</span>
      </div>
      <a
        href="https://wa.me/50577773083?text=Hola%20Nova%20Lab!%20%F0%9F%91%8B%20No%20encuentro%20un%20servicio%20en%20el%20tarifario%20y%20deseo%20consultar%20un%20caso%20especial."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#25D366]/15 hover:bg-[#25D366]/25 border border-[#25D366]/30 text-[#25D366] font-bold text-xs whitespace-nowrap transition-all active:scale-95 shadow-sm shadow-[#25D366]/10 shrink-0"
      >
        <svg class="size-4 shrink-0 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>¿No encuentras el servicio? Consúltanos</span>
      </a>
    </div>
  </div>
</LabLayout>
